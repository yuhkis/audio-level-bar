<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Applied only when make app signs with a certificate named by
	CODESIGN_IDENTITY. That signature carries the hardened runtime, which
	denies microphone input to a process without this entitlement.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
